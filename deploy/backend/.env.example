# Cloudflare Workers AI (OpenAI-compatible endpoint)
# Docs:
#   https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/
#   https://developers.cloudflare.com/workers-ai/models/qwen2.5-coder-32b-instruct/
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LLM_API_KEY=your-cloudflare-workers-ai-token
LLM_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
# Cloudflare OpenAI-compatible API exposes /chat/completions (not /completions)
LLM_API_MODE=chat

# CORS: comma-separated list of allowed frontend origins (add your Cloudflare Pages URL)
CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev

# Optional overrides (fixed defaults live in app/settings.py)
# FEW_SHOT_K=0
# TABLE_SIMILARITY_THRESHOLD=0.65
# RATE_LIMIT_PER_MINUTE=30
# GLOBAL_GENERATE_PER_MINUTE=60
# GLOBAL_GENERATE_PER_DAY=500
# TRUST_CF_CONNECTING_IP=false
