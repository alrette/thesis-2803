# OpenAI-compatible Qwen2.5-Coder-7B-Instruct API credentials
# Examples:
#   Alibaba DashScope (intl): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   HF Inference Providers:   https://router.huggingface.co/v1
#   SiliconFlow / DeepInfra:  <provider OpenAI-compatible base URL>
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
LLM_API_MODE=chat

# CORS: comma-separated list of allowed frontend origins (add your Cloudflare Pages URL)
CORS_ORIGINS=http://localhost:5173,https://your-project.pages.dev

# Optional overrides (fixed defaults live in app/settings.py)
# FEW_SHOT_K=3
# TABLE_SIMILARITY_THRESHOLD=0.65
